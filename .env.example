# Copy this file to .env and fill in real values. Never commit .env.

# Path to your fine-tuned FinGPT HuggingFace model checkpoint
FINGPT_MODEL_PATH=/path/to/fingpt-checkpoint

# Optional LoRA adapter path to apply on top of FINGPT_MODEL_PATH
FINGPT_ADAPTER_PATH=/path/to/lora-adapter

# If true, Agent 1 and Agent 2 reuse one shared LLM instance
SHARE_SINGLE_LLM_BETWEEN_AGENTS=true

# News provider: alpaca or finnhub
NEWS_PROVIDER=alpaca

# Alpaca News API credentials
ALPACA_API_KEY=your-alpaca-key-id
ALPACA_API_SECRET=your-alpaca-secret-key

# Finnhub API credentials
FINNHUB_API_KEY=your-finnhub-api-key
